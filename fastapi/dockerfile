FROM python:3.11-slim

# Thiết lập môi trường
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/fastapi \
    YOLO_CONFIG_DIR=/tmp/Ultralytics

# Đặt thư mục làm việc
WORKDIR /fastapi/app

# Cài đặt các gói hệ thống cần thiết (chỉ một lần)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    libmagic-dev \
    libmagic-mgc \
    && rm -rf /var/lib/apt/lists/*

# Sao chép file requirements trước (tối ưu cache layer)
COPY requirements.txt .

# Upgrade pip first
RUN pip install --upgrade pip

# Cài đặt dependencies Python với timeout và retry
RUN pip install --default-timeout=100 --retries 5 --no-cache-dir -r requirements.txt && \
    pip install --default-timeout=100 --retries 5 --no-cache-dir alembic

# Sao chép toàn bộ project vào /fastapi
COPY . /fastapi/

# Expose port
EXPOSE 8000

# Lệnh khởi chạy
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]