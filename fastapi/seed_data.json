  "notification_templates": [
    {
      "name": "Thông báo vi phạm giao thông",
      "notification_code": "VIOLATION_ALERT",
      "language": "vi",
      "subject_template": "Thông báo vi phạm giao thông - Biển số {{license_plate}}",
      "email_template": "Kính gửi {{owner_name}},\n\nHệ thống phát hiện phương tiện {{license_plate}} của quý khách có hành vi vi phạm:\n\nLoại vi phạm: {{violation_type}}\nThời gian: {{detected_at}}\nĐịa điểm: {{location_name}}\nMức phạt: {{fine_amount}} VND\nĐiểm trừ: {{points_deducted}} điểm\n\nVui lòng thanh toán trước {{due_date}}.\n\nTrân trọng,\nHệ thống quản lý vi phạm giao thông",
      "sms_template": "Vi pham {{license_plate}}: {{violation_type}} tai {{location_name}}. Phat {{fine_amount}}d. Han {{due_date}}",
      "push_template": "Phát hiện vi phạm {{violation_type}} - Biển số {{license_plate}}",
      "web_template": "Phương tiện {{license_plate}} vi phạm {{violation_type}} tại {{location_name}} lúc {{detected_at}}. Mức phạt: {{fine_amount}} VND",
      "default_channel": ["EMAIL", "SMS"],
      "is_auto_send": true,
      "available_variables": [
        "license_plate",
        "owner_name",
        "violation_type",
        "detected_at",
        "location_name",
        "fine_amount",
        "points_deducted",
        "due_date"
      ],
      "variable_description": {
        "license_plate": "Biển số xe",
        "owner_name": "Tên chủ phương tiện",
        "violation_type": "Loại vi phạm",
        "detected_at": "Thời gian phát hiện",
        "location_name": "Địa điểm vi phạm",
        "fine_amount": "Số tiền phạt",
        "points_deducted": "Điểm bị trừ",
        "due_date": "Hạn thanh toán"
      },
      "trigger_condition": {
        "event": "violation_detected",
        "auto_send": true
      },
      "allowed_entities": ["VIOLATION"],
      "is_active": true,
      "version": "1.0"
    },
    {
      "name": "Nhắc nhở thanh toán phạt",
      "notification_code": "PAYMENT_REMINDER",
      "language": "vi",
      "subject_template": "Nhắc nhở thanh toán phạt vi phạm - {{violation_code}}",
      "email_template": "Kính gửi {{owner_name}},\n\nQuý khách còn {{days_remaining}} ngày để thanh toán khoản phạt vi phạm giao thông:\n\nMã vi phạm: {{violation_code}}\nBiển số: {{license_plate}}\nSố tiền: {{amount}} VND\nHạn cuối: {{due_date}}\n\nVui lòng thanh toán để tránh các biện pháp xử lý tiếp theo.\n\nTrân trọng.",
      "sms_template": "Nhac nho: Con {{days_remaining}} ngay de thanh toan phat {{amount}}d cho bien so {{license_plate}}",
      "push_template": "Còn {{days_remaining}} ngày thanh toán phạt {{amount}} VND",
      "web_template": "Nhắc nhở: Thanh toán phạt {{amount}} VND cho vi phạm {{violation_code}} trước {{due_date}}",
      "default_channel": ["EMAIL", "SMS"],
      "is_auto_send": true,
      "available_variables": [
        "owner_name",
        "violation_code",
        "license_plate",
        "amount",
        "due_date",
        "days_remaining"
      ],
      "is_active": true,
      "version": "1.0"
    },
    {
      "name": "Xác nhận thanh toán",
      "notification_code": "PAYMENT_CONFIRMATION",
      "language": "vi",
      "subject_template": "Xác nhận thanh toán thành công - {{receipt_number}}",
      "email_template": "Kính gửi {{payer_name}},\n\nChúng tôi xác nhận đã nhận được khoản thanh toán:\n\nSố biên lai: {{receipt_number}}\nSố tiền: {{amount}} VND\nPhương thức: {{payment_method}}\nThời gian: {{paid_at}}\n\nCảm ơn quý khách đã thanh toán đúng hạn.\n\nTrân trọng.",
      "sms_template": "Xac nhan thanh toan {{amount}}d thanh cong. Ma GD: {{receipt_number}}",
      "push_template": "Thanh toán {{amount}} VND thành công",
      "web_template": "Đã nhận thanh toán {{amount}} VND - Biên lai {{receipt_number}}",
      "default_channel": ["EMAIL", "SMS"],
      "is_auto_send": true,
      "available_variables": [
        "payer_name",
        "receipt_number",
        "amount",
        "payment_method",
        "paid_at"
      ],
      "is_active": true,
      "version": "1.0"
    }
